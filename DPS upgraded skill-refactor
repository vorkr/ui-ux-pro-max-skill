pan></th></tr></thead><tbody><tr><td><span class="">J-01</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">72h human verification wait</span></td></tr><tr><td><span class="">J-02</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">7-day recipient wait</span></td></tr><tr><td><span class="">J-03</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">5-day evidence wait</span></td></tr><tr><td><span class="">J-04</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">5-day partner wait</span></td></tr><tr><td><strong><span class="">J-05</span></strong></td><td><strong><span class="">Stateless</span></strong></td><td><strong><span class="">no</span></strong></td><td><strong><span class="">48h max; no long waits; FIRST SLICE</span></strong></td></tr><tr><td><span class="">J-06</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">14-day stall detection</span></td></tr><tr><td><span class="">J-07</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">72h acceptance wait</span></td></tr><tr><td><span class="">J-08</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">30-day dispute window</span></td></tr><tr><td><span class="">J-09</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">14-day review wait</span></td></tr><tr><td><span class="">J-10</span></td><td><span class="">Stateless</span></td><td><span class="">no</span></td><td><span class="">scheduled sweep, short steps</span></td></tr><tr><td><span class="">J-11</span></td><td><span class="">Windmill</span></td><td><span class="">yes</span></td><td><span class="">30-day retention wait</span></td></tr><tr><td><span class="">J-12